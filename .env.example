# Recommended API-backed mode. Falls back to the local starter catalog without a key.
FRAGRANCE_DATA_SOURCE=fragella

# Use this for a full imported catalog in PostgreSQL/Supabase/Neon.
DATABASE_URL=

# Use this for live Fragella API search.
FRAGELLA_API_KEY=
FRAGELLA_DEFAULT_SEARCH=a

# Optional cache-sync tuning (one prefix batch per selector request).
FRAGELLA_SYNC_BATCH_LIMIT=500
FRAGELLA_SYNC_MAX_DEPTH=3
FRAGELLA_SYNC_MIN_INTERVAL_SECONDS=30
